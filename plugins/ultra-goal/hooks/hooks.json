{
  "description": "Gate an active goal on its anchor and re-state the sections it may change, restore its frozen spec and carried state after a session or compaction boundary, and record a failed delegation via PostToolUseFailure so a degraded round cannot read as a clean one. Silent in any project without a .goals/active marker. This file is auto-discovered by Claude Code and zCode alike, so it carries only the events both hosts document: zCode has no PreCompact at all (that lives in hooks/claude.json and hooks/codex.json), and Codex, whose manifest replaces discovery with its own file, does not document PostToolUseFailure.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_stop.py\" ${ZCODE_PLUGIN_ROOT:+--host zcode} || python \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_stop.py\" ${ZCODE_PLUGIN_ROOT:+--host zcode}",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\skills\\ultra-goal\\scripts\\goal_stop.py\"",
            "timeout": 600,
            "statusMessage": "Checking the loop's anchor"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_session_start.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\skills\\ultra-goal\\scripts\\goal_session_start.py\"",
            "timeout": 10,
            "statusMessage": "Restoring the active loop"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_tool_failure.py\" || python \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/ultra-goal/scripts/goal_tool_failure.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\skills\\ultra-goal\\scripts\\goal_tool_failure.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
